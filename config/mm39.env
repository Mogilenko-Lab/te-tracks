# Pins for mouse GRCm39 / mm39.
# Every value here is measured. The build verifies each download against its md5 and aborts on a
# mismatch, so a silently changed source surfaces as a failed fetch.

GENOME=mm39
ASSEMBLY=GRCm39
GENE_ANNOTATION="GENCODE vM37"

# --- sources -----------------------------------------------------------------
UCSC_BASE="https://hgdownload.soe.ucsc.edu/goldenPath/mm39"
GENCODE_BASE="https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_mouse/release_M37"

# Three files are fetched and each one is pinned. src/00_fetch_sources.sh aborts on a mismatch.
RMSK_URL="${UCSC_BASE}/database/rmsk.txt.gz"
CHROMALIAS_URL="${UCSC_BASE}/bigZips/mm39.chromAlias.txt"
GENE_GTF_URL="${GENCODE_BASE}/gencode.vM37.primary_assembly.annotation.gtf.gz"

# UCSC md5s, measured 2026-09-14. UCSC republishes these on assembly updates, so adopting a new
# release is the deliberate act of updating the pin and the EXPECT_* counts together.
RMSK_MD5="ca2e5542cab0390b5458e7935e891430"
CHROMALIAS_MD5="cd2f6474b8f0bceb862719430821a33b"

# GENCODE md5, confirmed byte-identical against the copy that produced 13036-DM and 14839-DM.
GENE_GTF_MD5="702e27a8727db66cd23e9f66f5aa1d38"

# --- assembly identity -------------------------------------------------------
# The genome FASTA these coordinates belong to. The build reads coordinates from rmsk, so it leaves
# the FASTA alone; the pin names the bytes a consumer aligns against.
GENOME_FA_URL="${GENCODE_BASE}/GRCm39.genome.fa.gz"
GENOME_FA_MD5="c4dfe32c560ffabf5068f57449a14511"

# --- the TE set --------------------------------------------------------------
# Classes carried into the TE set. Satellite is carried, which makes "TE" here mean
# "interspersed repeat plus satellite". docs/DECISIONS.md states the reasoning.
TE_CLASSES="SINE LTR LINE DNA Satellite Retroposon Unknown RC Unspecified DNA?"

# Families excluded within the carried classes, matched on the repFamily prefix.
# In mm39 this matches the three families RepeatMasker names for their ancestral source RNA, and it
# drops one ancient SINE subfamily each: LFSINE_Vert 1235, MamSINE1 925, AmnSINE2 388.
# The tRNA-derived SINE families carrying lineage names stay in the set: B2 370294, B4 380688,
# ID 60640, MIR 120815. This filter reproduces the packaged annotation the lab has used, and
# docs/DECISIONS.md records its standing.
EXCLUDE_FAMILY_PREFIX="tRNA"

# --- identity ----------------------------------------------------------------
# locus_id form. `selfdesc` yields  L1MdA_VI|chr1:3050294-3050775|+
# and stays stable under any change to the class filter.
LOCUS_ID_FORM="selfdesc"

# --- genic context -----------------------------------------------------------
# Read by the genic-context stage. Distance in bp from a gene body that marks a locus intergenic.
# The context table also carries the exact signed distance, so this threshold is re-cuttable at
# query time.
INTERGENIC_MIN=20000

# --- expected shape ----------------------------------------------------------
# Asserted by src/99_verify.sh. Measured 2026-09-12 from rmsk.
#
# The locus set matches the annotation used by 14839-DM exactly: 3,799,629 records joining
# 1:1 on coordinates. The label counts differ, and these are the rmsk values:
#   subfamilies  1225 here, 1226 there  (ID4_v arrives there as ID4_. and ID4_v)
#   triples      1245 here, 1243 there  (family Unknown arrives there as the subfamily name)
# docs/PROVENANCE.md holds the measurements.
EXPECT_LOCI=3799629
EXPECT_CONTIGS=59
EXPECT_SUBFAMILIES=1225
EXPECT_TRIPLES=1245

# Read by the exon-subtracted view stage.
EXPECT_LOCI_NOEXON=3717740
