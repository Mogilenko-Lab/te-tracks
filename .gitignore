# Build products live in the reference cache. The repo carries logic and expectations.
*.gz
*.bed
*.saf
*.gtf
*.parquet
*.locInd
*.tsv
work/
__pycache__/

# Reviewed class policies ship with the builder.
!config/*.tsv

# Expectations are part of the contract and stay tracked.
!tests/expectations/**

# Fixtures preserve consumer inputs and expected results.
!tests/fixtures/**

# Pinned Dfam metadata ships with the builder.
!data/dfam/**

# Internal memory carries its tables and worksheets.
!docs/_internal/**/*.tsv
